# Copy to secrets.yaml and fill in your values:
#   copy secrets.yaml.example secrets.yaml

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate: openssl rand -base64 32
api_encryption_key: "GENERATE_WITH_esphome_secrets_or_openssl"

ota_password: "YOUR_OTA_PASSWORD"
ap_password: "YOUR_FALLBACK_AP_PASSWORD"

# Bluetooth MAC of your Duratech Link Mini (advertising address from nRF Connect / sniffer)
# Note: DuraCloud may show a nearby address ending differently — use the advertising MAC.
link_mini_mac: "AA:BB:CC:DD:EE:FF"
